#!/bin/sh
set -e

LABEL="com.cy.cybridged"
WATCH_LABEL="com.cy.cybridgewatchdog"
PLIST="@PLIST@"
WATCH_PLIST="@WATCH_PLIST@"

launchctl bootout "system/$WATCH_LABEL" 2>/dev/null || true
launchctl unload "$WATCH_PLIST" 2>/dev/null || true
launchctl bootout "system/$LABEL" 2>/dev/null || true
launchctl unload "$PLIST" 2>/dev/null || true
exit 0
